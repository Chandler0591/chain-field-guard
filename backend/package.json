{
  "name": "chain-field-guard-backend",
  "version": "1.0.0",
  "description": "链田守护后端:Express + @hyperledger/fabric-gateway 提交链上交易,kubo-rpc-client 上传 IPFS",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
